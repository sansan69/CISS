rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAllowedSize() {
      return request.resource.size < 5 * 1024 * 1024;
    }

    function isAllowedEnrollmentImageSize() {
      return request.resource.size < 15 * 1024 * 1024;
    }

    function isAllowedTrainingSize() {
      return request.resource.size < 100 * 1024 * 1024;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    function isDocument() {
      return isImage() || request.resource.contentType == 'application/pdf';
    }

    function isTrainingContent() {
      return isImage()
        || request.resource.contentType == 'application/pdf'
        || request.resource.contentType == 'application/msword'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        || request.resource.contentType == 'application/vnd.openxmlformats-officedocument.presentationml.presentation';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'superAdmin'
      );
    }

    function isFieldOfficer() {
      return isSignedIn() && request.auth.token.role == 'fieldOfficer';
    }

    function isHR() {
      return isSignedIn() && request.auth.token.role == 'hr';
    }

    function isAccounts() {
      return isSignedIn() && request.auth.token.role == 'accounts';
    }

    function isCompliance() {
      return isSignedIn() && request.auth.token.role == 'compliance';
    }

    // Mirrors isStaff() in firestore.rules: every staff role, but never a guard
    // and never a client user. Document and selfie reads are staff-only; those
    // two roles fetch their own files through Admin-SDK server routes.
    function isStaff() {
      return isAdmin() || isHR() || isAccounts() || isCompliance() || isFieldOfficer();
    }

    // Restricted Aadhaar files are uploaded and streamed only by server routes.
    match /restrictedEmployeeAadhaar/{employeeId}/{fileName} {
      allow read, write: if false;
    }

    match /restrictedAadhaarStaging/{uid}/{fileName} {
      allow read, write: if false;
    }

    match /restrictedEmployeeConsent/{employeeId}/{fileName} {
      allow read, write: if false;
    }

    function reportIsDraftOrNotCreated(reportType, reportId) {
      return (
        reportType == 'visit' &&
        (
          !firestore.exists(/databases/(default)/documents/foVisitReports/$(reportId)) ||
          firestore.get(/databases/(default)/documents/foVisitReports/$(reportId)).data.status == 'draft'
        )
      ) || (
        reportType == 'training' &&
        (
          !firestore.exists(/databases/(default)/documents/foTrainingReports/$(reportId)) ||
          firestore.get(/databases/(default)/documents/foTrainingReports/$(reportId)).data.status == 'draft'
        )
      );
    }

    // Report-bound private evidence. Reads are issued by the authenticated
    // application as short-lived signed URLs after report-scope authorization.
    match /foReports/{reportType}/{uid}/{reportId}/{fileName} {
      allow read: if false;
      allow create: if isFieldOfficer()
        && request.auth.uid == uid
        && (reportType == 'visit' || reportType == 'training')
        && isAllowedEnrollmentImageSize()
        && isDocument()
        && request.resource.metadata.reportId == reportId
        && request.resource.metadata.uploaderId == uid;
      allow delete: if isFieldOfficer()
        && request.auth.uid == uid
        && reportIsDraftOrNotCreated(reportType, reportId);
      allow update: if false;
    }

    // F-01: Field officer report photo uploads — admins read every officer's
    // evidence; a field officer reads only the files they uploaded themselves.
    match /foReports/{folder}/{uid}/{fileName} {
      allow read: if isAdmin() || (isFieldOfficer() && request.auth.uid == uid);
      allow create: if isFieldOfficer() && request.auth.uid == uid && (
        (folder == 'trainingReportFiles' && isAllowedTrainingSize() && isTrainingContent()) ||
        (folder != 'trainingReportFiles' && isAllowedSize() && isDocument())
      );
      allow update: if isAdmin() && (
        (folder == 'trainingReportFiles' && isAllowedTrainingSize() && isTrainingContent()) ||
        (folder != 'trainingReportFiles' && isAllowedSize() && isDocument())
      );
      allow delete: if isAdmin();
    }

    // Legacy employee file paths. Public attendance can still upload attendance
    // photos here.
    // Profile pictures — readable by any authenticated user (was public).
    // All other employee paths contain sensitive PII and are admin-only.
    match /employees/{employeeKey}/profilePictures/{fileName} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isAllowedSize() && isImage();
      allow update: if isAdmin() && isAllowedSize() && isImage();
      allow delete: if isAdmin();
    }

    // Signature images are PII used on ID cards and official documents. Reads
    // are staff-only. Guards and client users never hold signature paths in the
    // browser: /api/employees/profile/[id]/document streams the file with the
    // Admin SDK after its own role check (client accounts are refused the
    // signature category), and the guard profile route only serves proof pages.
    match /employees/{employeeKey}/signatures/{fileName} {
      allow read: if isStaff();
      allow create: if isAdmin() && isAllowedSize() && isImage();
      allow update: if isAdmin() && isAllowedSize() && isImage();
      allow delete: if isAdmin();
    }


    // Attendance selfies are PII. Reads are staff-only: a guard views their own
    // selfie through the tokenized URL returned by the attendance APIs, and
    // client users through the attendance report server route.
    match /employees/{employeeKey}/attendance/{attemptId}/{fileName} {
      allow read: if isStaff();
      // Attendance photos are written only by the validated server upload route.
      allow create: if false;
      allow update: if isAdmin() && isAllowedEnrollmentImageSize() && isImage();
      allow delete: if isAdmin();
    }

    match /employees/{employeeKey}/idProofs/{fileName} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isAllowedSize() && isDocument();
      allow update: if isAdmin() && isAllowedSize() && isDocument();
      allow delete: if isAdmin();
    }

    match /employees/{employeeKey}/addressProofs/{fileName} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isAllowedSize() && isDocument();
      allow update: if isAdmin() && isAllowedSize() && isDocument();
      allow delete: if isAdmin();
    }

    match /employees/{employeeKey}/serviceBooks/{fileName} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isAllowedSize() && isDocument();
      allow update: if isAdmin() && isAllowedSize() && isDocument();
      allow delete: if isAdmin();
    }

    match /employees/{employeeKey}/armsLicenses/{fileName} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isAllowedSize() && isDocument();
      allow update: if isAdmin() && isAllowedSize() && isDocument();
      allow delete: if isAdmin();
    }

    match /employees/{employeeKey}/aadharCards/{fileName} {
      allow read, write: if false;
    }

    match /employees/{employeeKey}/panCards/{fileName} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isAllowedSize() && isDocument();
      allow update: if isAdmin() && isAllowedSize() && isDocument();
      allow delete: if isAdmin();
    }

    match /employees/{employeeKey}/passports/{fileName} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isAllowedSize() && isDocument();
      allow update: if isAdmin() && isAllowedSize() && isDocument();
      allow delete: if isAdmin();
    }

    match /employees/{employeeKey}/bankDocuments/{fileName} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isAllowedSize() && isDocument();
      allow update: if isAdmin() && isAllowedSize() && isDocument();
      allow delete: if isAdmin();
    }

    match /employees/{employeeKey}/policeCertificates/{fileName} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isAllowedSize() && isDocument();
      allow update: if isAdmin() && isAllowedSize() && isDocument();
      allow delete: if isAdmin();
    }

    match /employees/{employeeKey}/qualificationCertificates/{fileName} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isAllowedSize() && isDocument();
      allow update: if isAdmin() && isAllowedSize() && isDocument();
      allow delete: if isAdmin();
    }

    // Training module content — admin upload, signed-in read
    match /trainingModules/{fileName=**} {
      allow read: if isSignedIn();
      allow create, update: if isAdmin() && isAllowedTrainingSize() && isTrainingContent();
      allow delete: if isAdmin();
    }

    // Enrollment uploads go through the server after it validates a short-lived
    // draft capability. Sensitive enrollment files remain admin-only.
    match /enrollments/{employeeKey}/profilePictures/{fileName} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /enrollments/{employeeKey}/signatures/{fileName} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /enrollments/{employeeKey}/idProofs/{fileName} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /enrollments/{employeeKey}/addressProofs/{fileName} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /enrollments/{employeeKey}/serviceBooks/{fileName} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /enrollments/{employeeKey}/armsLicenses/{fileName} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /enrollments/{employeeKey}/aadharCards/{fileName} {
      allow read, write: if false;
    }


    match /enrollments/{employeeKey}/panCards/{fileName} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /enrollments/{employeeKey}/passports/{fileName} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /enrollments/{employeeKey}/bankDocuments/{fileName} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /enrollments/{employeeKey}/policeCertificates/{fileName} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /enrollments/{employeeKey}/qualificationCertificates/{fileName} {
      allow read: if isAdmin();
      allow create: if false;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Payslip PDFs — server-only. Guards download through
    // /api/guard/payslips/{id}/payslip, which checks employeeDocId ownership
    // before streaming; clients must never be able to read or enumerate each
    // other's payslips. (The catch-all below already denies these paths; this
    // block states the intent so a future broad employees/** rule cannot
    // silently re-open payslips.)
    match /employees/{employeeKey}/payslips/{period}/{fileName} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
