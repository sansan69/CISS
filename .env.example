NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_SUPER_ADMIN_EMAIL=admin@cisskerala.app

FIREBASE_ADMIN_SDK_CONFIG_BASE64=
FIREBASE_ADMIN_SDK_CONFIG=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
FIREBASE_ADMIN_STORAGE_BUCKET=your-project.firebasestorage.app
# Local-only: set true to use `gcloud auth application-default login`
# instead of a service-account key.
FIREBASE_ADMIN_PREFER_APPLICATION_DEFAULT=false
SUPER_ADMIN_EMAIL=admin@cisskerala.app

OPENCAGE_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openrouter/free
OPENROUTER_WAGE_MODEL=openrouter/free
OPENROUTER_VISION_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://cisskerala.site
OPENROUTER_APP_NAME=CISS Workforce

APP_MODE=regional
REGION_CODE=KL
REGION_NAME=Kerala
NEXT_PUBLIC_APP_MODE=regional
NEXT_PUBLIC_REGION_CODE=KL
NEXT_PUBLIC_REGION_NAME=Kerala
GUARD_AUTH_EMAIL_DOMAIN=

# ── Required in production ──────────────────────────────────────────────
# These variables MUST be set for the application to function correctly in
# production (Vercel or similar). Some are also needed locally.

# Secret shared with Vercel Cron Jobs to authenticate cron-triggered
# endpoints (e.g. auto-checkout). Generate a strong random value.
CRON_SECRET=
ATTENDANCE_VERIFICATION_SECRET=
UPLOAD_TOKEN_SECRET=

# Unique, stable encryption key for cross-region connection credentials
# (service account JSON). Once set, do not change it — doing so would
# render all previously encrypted region connections undecryptable.
# Must be set explicitly in production; do NOT rely on falling back to
# FIREBASE_ADMIN_PRIVATE_KEY.
REGION_CONNECTIONS_SECRET=

# Vercel personal access token used for deployment-triggered operations
# (e.g. invoking serverless functions after redeploys).
VERCEL_TOKEN=

# OpenCage Geocoding API key for reverse-geocoding guard locations.
# Obtain from https://opencagedata.com/
OPENCAGE_API_KEY=

# Application mode: "regional" (multi-region) or "single" (single-region).
# Controls routing, data isolation, and UI behaviour.
APP_MODE=regional

# Region code (e.g. "KL" for Kerala). Used for data partitioning and
# cross-region routing.
REGION_CODE=KL

# Human-readable region name (e.g. "Kerala").
REGION_NAME=Kerala
